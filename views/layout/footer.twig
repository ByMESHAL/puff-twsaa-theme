<footer class="puff-footer" dir="rtl">
  <div class="puff-footer-logo"><a href="{{ puff.destination.pageLinks.home }}"><img src="{{ puff.brand.logo }}" alt="Puff" width="1774" height="887" loading="lazy"></a></div>
  <div class="puff-footer-contact"><p>للاستفسارات والتواصل</p><a href="mailto:{{ puff.brand.contactEmail }}">{{ puff.brand.contactEmail }}</a></div>
  <nav class="puff-footer-policies" aria-label="سياسات المتجر"><span>© {{ 'now'|date('Y') }} Puff</span>
    {% for policy in puff.policies %}<a href="{{ puff.destination.policyLinks[policy.type] }}">{{ policy.title }}</a>{% endfor %}
  </nav>
  <div class="puff-registration" aria-label="البيانات النظامية للمتجر">
    <div class="puff-registration-item"><span class="puff-reg-logo puff-vat-original" aria-hidden="true"></span><div><span class="puff-reg-label">الرقم الضريبي</span><bdi class="puff-reg-number">{{ puff.brand.vat }}</bdi></div></div>
    <div class="puff-registration-item"><span class="puff-reg-logo puff-saudi-original" aria-hidden="true"></span><div><span class="puff-reg-label">السجل التجاري</span><bdi class="puff-reg-number">{{ puff.brand.commercialRegistration }}</bdi></div></div>
  </div>
  <div class="puff-native-payments">{% if getFunction('getDefaultPaymentMethod').getAdminPaymentMethod and getFunction('getDefaultPaymentMethod').getAdminPaymentMethod['active']|default(0) == 1 %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/visa.png" alt="visa">
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/mastercard.png" alt="mastercard">
                        {% if getSuperConfig('store.current_country_code') != "OM" %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/mada.png" alt="mada">
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/applepay.png" alt="applepay">
                        {% endif %}
                        {% endif %}
                        {% if getFunction('getInstallmentPaymentMethod').getAdminPaymentMethod and getFunction('getInstallmentPaymentMethod').getAdminPaymentMethod['active']|default(0) == 1 %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/cod.png" alt="cod">
                        {% endif %}
                        {% if (getFunction('getTabbyPaymentMethod') and getFunction('getTabbyPaymentMethod').active|default(0)) == 1 and (getFunction('getTabbyPaymentMethod').getAdminPaymentMethod['active']|default(0)) == 1 %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/tabby.webp" alt="tabby">
                        {% endif %}
                        {% if (getFunction('getTamaraPaymentMethod') and getFunction('getTamaraPaymentMethod').active|default(0)) == 1 and (getFunction('getTamaraPaymentMethod').getAdminPaymentMethod['active']|default(0)) == 1 %}
                        <img src="https://twsaa.com/admin-themes/mbotiq/assets/images/payments/tamara.svg" alt="tamara">
                        {% endif %}
                        </div>
</footer>
